# Copy this file to .env and adjust values. Never commit .env.

# Main application database (async SQLAlchemy URL).
DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow

# Separate database used by the test suite (created by docker/postgres-init).
TEST_DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow_test

# Gemini (used from Part 2 onwards). Leave empty for Part 1.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_TEMPERATURE=0.3
# Researcher uses Google Search grounding when true (needs a key with grounding quota).
ENABLE_SEARCH_GROUNDING=false
# Fast model for worker agents and Quick Ask (empty = GEMINI_MODEL). The planner always uses GEMINI_MODEL.
GEMINI_WORKER_MODEL=gemini-3.5-flash-lite

# Live web research (free). auto = Tavily if TAVILY_API_KEY is set, else ddgs (no key, metasearch).
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_BACKENDS=yahoo, bing, yandex, google
# Optional, free tier at tavily.com (better page text):
TAVILY_API_KEY=
WEB_MAX_RESULTS=6
WEB_MAX_PAGES=4
WEB_PAGE_CHARS=3500
WEB_FETCH_TIMEOUT_SECONDS=6
# Max characters of upstream task outputs included in an agent prompt.
MAX_CONTEXT_CHARS=20000

# Planning (Part 3)
MAX_PLAN_TASKS=12
PLANNER_MAX_REPAIR_ATTEMPTS=2
# minimal | low | medium | high (Gemini 3+; ignored otherwise)
PLANNER_THINKING_LEVEL=high
WORKER_THINKING_LEVEL=low

# Execution engine (Part 4)
ENGINE_ENABLED=true
ENGINE_MAX_CONCURRENCY=4
ENGINE_POLL_INTERVAL_SECONDS=1.0
TASK_TIMEOUT_SECONDS=180
ENGINE_SHUTDOWN_GRACE_SECONDS=10
# Leave unset to use hostname-pid-random
# ENGINE_WORKER_ID=

# Reliability (Part 5)
# gemini = real API; fake = canned demo outputs (no network, no cost) - dev/demo only
LLM_PROVIDER=gemini
FAKE_LLM_DELAY_SECONDS=3
# Tried in order when the primary is overloaded (503) or not found (404). Quota errors do NOT fall back.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_COOLDOWN_SECONDS=120
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=60
RETRY_JITTER=true
DEFAULT_TASK_MAX_ATTEMPTS=3
LEASE_DURATION_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
# true = one engine process: on startup every RUNNING task is orphaned and reclaimed at once
ENGINE_SINGLE_NODE=true
CHAOS_CRASH_DELAY_SECONDS=2

# Multi-provider AI + cost control (Part 8). Every key is optional: providers without one are skipped.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local Ollama (free). Registered only when it answers at startup.
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT_SECONDS=120
# Routes per agent role + quotas (see config/models.example.yaml). Missing file = Gemini-only, as before.
MODELS_CONFIG_PATH=config/models.yaml
PRICING_CONFIG_PATH=config/pricing.yaml
# Daily quota windows reset at midnight in this timezone (Google: America/Los_Angeles)
QUOTA_TIMEZONE=UTC
# Default workflow budgets (empty = unlimited). DEFAULT_MAX_LLM_CALLS is a safety net.
DEFAULT_MAX_COST_USD=
DEFAULT_MAX_TOKENS=
DEFAULT_MAX_LLM_CALLS=50
DEFAULT_MAX_DURATION_SECONDS=
DEFAULT_ESTIMATED_OUTPUT_TOKENS=1500

# Human controls (Part 6)
# Required when APP_ENV=production. Control/approval endpoints then need header X-API-Key.
# Leave empty in development for an open control API.
ADMIN_API_KEY=
# Pending approvals expire after this many hours (0 = never)
APPROVAL_TIMEOUT_HOURS=24
# Optional: POST each new approval request here (best effort, 5s timeout)
APPROVAL_WEBHOOK_URL=
# Where the publisher agent writes published Markdown
# PUBLISH_DIR=outputs/published

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# development | test | production
APP_ENV=development

# --- Tools + safe actions (Part 9) ---
# Copy config/tools.example.yaml to config/tools.yaml to give agents tools (no file = no tools).
# TOOLS_CONFIG_PATH=config/tools.yaml
# Part 11: approval / deny rules (see config/policies.example.yaml)
# POLICIES_CONFIG_PATH=config/policies.yaml
# MAX_TOOL_STEPS=8
# TOOL_LOOP_TIMEOUT_SECONDS=900
# TOOL_RESULT_REUSE_SECONDS=3600
# Read-only sample data source for sql_query (create it: python scripts/setup_sample_data.py)
# SAMPLE_DATA_URL=postgresql+asyncpg://agentflow_reader:reader@localhost:5432/agentflow_sample
# SAMPLE_DB_READER_PASSWORD=reader
